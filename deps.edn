  cheshire/cheshire {:mvn/version "5.11.0"}

  clj-http/clj-http {:mvn/version "3.12.3"}}

 :paths ["src"]

 :aliases
 {:dev {:main-opts ["-m" "insurance-challenge.core"]}
  :prod {:main-opts ["-m" "insurance-challenge.core"]}
